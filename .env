
CREATE DATABASE IF NOT EXISTS control_vehiculos 
CHARACTER SET utf8mb4 
COLLATE utf8mb4_unicode_ci;

-- Crear el usuario específico con una contraseña
CREATE USER 'coni_user'@'localhost' IDENTIFIED WITH caching_sha2_password BY '123456';

-- Asignar todos los privilegios sobre la base de datos completa
GRANT ALL PRIVILEGES ON control_vehiculos.* TO 'fleet_user'@'localhost';

-- Grabar y refrescar los privilegios inmediatamente
FLUSH PRIVILEGES;


-- usuario para docente 
CREATE USER 'baileytorch'@'%' IDENTIFIED WITH caching_sha2_password BY 'profe123';

--  Asignarle todos los privilegios CRUD sobre la base de datos completa de control de vehículos
GRANT ALL PRIVILEGES ON control_vehiculos.* TO 'baileytorch'@'%';

--  Grabar y refrescar los privilegios inmediatamente
FLUSH PRIVILEGES;
